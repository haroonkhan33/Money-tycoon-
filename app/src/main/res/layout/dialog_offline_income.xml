<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_bottom_sheet_missions"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Glowing Icon -->
    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:background="@drawable/bg_icon_circle_green"
        android:padding="12dp"
        android:src="@drawable/ic_bolt"
        app:tint="@color/neon_green"
        android:contentDescription="Welcome Back" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="WELCOME BACK, TYCOON!"
        android:textColor="@color/text_primary"
        android:textSize="17sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:id="@+id/tvOfflineTimeAway"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Your automated managers worked while you were away"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        android:gravity="center" />

    <!-- Revenue Payout Banner Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginVertical="16dp"
        app:cardBackgroundColor="@color/bg_surface"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/neon_green_border"
        app:strokeWidth="1.2dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFLINE REVENUE COLLECTED"
                android:textColor="@color/text_muted"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />

            <TextView
                android:id="@+id/tvOfflineEarningsAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="+$15,840.00"
                android:textColor="@color/neon_green"
                android:textSize="26sp"
                android:textStyle="bold"
                android:shadowColor="@color/neon_green_glow"
                android:shadowDx="0"
                android:shadowDy="0"
                android:shadowRadius="10" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Collect Revenue Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCollectOfflineIncome"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:backgroundTint="@color/neon_green"
        android:text="COLLECT &amp; MULTIPLY"
        android:textColor="@color/text_on_neon"
        android:textSize="14sp"
        android:textStyle="bold"
        android:letterSpacing="0.04"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_bolt"
        app:iconGravity="textStart"
        app:iconPadding="8dp"
        app:iconTint="@color/text_on_neon" />
</LinearLayout>
